# Скопируйте в .env.local и подставьте значения своей базы.
# .env* в .gitignore — реальные значения в репозиторий не попадают.

# Адрес Supabase-инстанса.
#   облако:        https://<ref>.supabase.co
#   self-hosted:   https://db.precettore.ru   (домен, за которым стоит Kong)
VITE_SUPABASE_URL=

# Публичный (anon / publishable) ключ. Он и так уходит в браузерный бандл —
# это не секрет, защита данных обеспечивается RLS, а не сокрытием ключа.
VITE_SUPABASE_ANON_KEY=
