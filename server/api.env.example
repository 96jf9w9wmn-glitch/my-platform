# Секреты серверных функций. На сервере лежит как /opt/precettore-web/api.env
# (root:root, chmod 600) и деплоем НЕ перезаписывается — раскатка трогает только
# каталог current/. Значения переносятся из панели Vercel (Settings → Environment
# Variables) один раз при переезде.
#
# Формат — env_file docker compose: KEY=value, БЕЗ кавычек и без `export`.
# Кавычки здесь попадут внутрь значения и токен молча перестанет подходить.

# --- База (та же, что у фронта) ---------------------------------------------
SUPABASE_URL=https://db.precettore.ru
SUPABASE_ANON_KEY=

# ВАЖНО: на Vercel этот ключ так и не был задан, из-за чего api/lesson-report.js
# и api/generate-hw.js работали фактически анонимно, а месячный лимит ИИ-генераций
# по тарифу не списывался (долг из CLAUDE.md). Переезд — момент это закрыть:
# без ключа проверка тарифа снова не включится.
SUPABASE_SERVICE_ROLE_KEY=

# --- Адреса ------------------------------------------------------------------
# Возврат после оплаты и ссылки в сообщениях бота.
PUBLIC_SITE_URL=https://precettore.ru
APP_URL=https://precettore.ru

# --- ИИ-генерация домашних заданий -------------------------------------------
DEEPSEEK_API_KEY=

# --- Телеграм-бот репетитора --------------------------------------------------
# TELEGRAM_DB_SECRET — доступ бота к базе через восемь RPC вместо service_role
# (в базе хранится только его SHA-256).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DB_SECRET=

# --- ЮKassa: магазин репетитора (оплата занятий) ------------------------------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — присылать чеки (нужен настроенный чекаут в кабинете ЮKassa).
YOOKASSA_RECEIPT=

# --- ЮKassa: магазин платформы (подписка репетитора) --------------------------
# Если не заданы, подписка использует магазин выше.
YOOKASSA_PLATFORM_SHOP_ID=
YOOKASSA_PLATFORM_SECRET_KEY=

# --- Вход репетитора через свой обработчик ------------------------------------
# Пять попыток на аккаунт и блокировка на 15 минут живут в /api/auth-login.
# Этим же секретом Caddy отличает наш запрос к GoTrue (grant_type=password) от
# браузерного и не даёт обойти счётчик, обратившись к GoTrue напрямую.
# Тот же ключ должен быть в /opt/precettore-db/.env — оттуда его берёт Caddy.
AUTH_PROXY_SECRET=
